<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- VUELOS -->
    <!-- ========================= -->

    <record id="view_vuelo_list" model="ir.ui.view">
        <field name="name">dronify.vuelo.list</field>
        <field name="model">dronify.vuelo</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="name"/>
                <field name="dron_id"/>
                <field name="piloto_id"/>
                <field name="zona_id"/>
                <field name="peso_total"/>
                <field name="consumo_estimado" widget="percentage"/>
                <field name="preparado" widget="boolean_toggle" class="text-center"/>
                <field name="realizado" widget="boolean_toggle" class="text-center"/>
            </list>
        </field>
    </record>

        <!-- ========================= -->
        <!-- ZONAS -->
        <!-- ========================= -->

        <record id="view_zona_list" model="ir.ui.view">
            <field name="name">dronify.zona.list</field>
            <field name="model">dronify.zona</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="distancia_km"/>
                    <field name="nivel_riesgo" widget="badge"
                        decoration-success="nivel_riesgo in ['1','2']"
                        decoration-info="nivel_riesgo == '3'"
                        decoration-warning="nivel_riesgo == '4'"
                        decoration-danger="nivel_riesgo == '5'"/>
                    <field name="tarifa_base"/>
                </list>
            </field>
        </record>

        <record id="view_zona_form" model="ir.ui.view">
            <field name="name">dronify.zona.form</field>
            <field name="model">dronify.zona</field>
            <field name="arch" type="xml">
                <form string="Zona de destino">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="distancia_km"/>
                            <field name="nivel_riesgo"/>
                            <field name="tarifa_base"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_zonas" model="ir.actions.act_window">
            <field name="name">Zonas</field>
            <field name="res_model">dronify.zona</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_zonas"
                  name="Zonas"
                  parent="menu_operaciones"
                  action="action_zonas"/>

    <record id="view_vuelo_form" model="ir.ui.view">
        <field name="name">dronify.vuelo.form</field>
        <field name="model">dronify.vuelo</field>
        <field name="arch" type="xml">
            <form string="Vuelo">
                <header>
                    <button name="action_preparar_vuelo"
                            type="object"
                            string="Preparar Vuelo"
                            class="btn-primary"
                            invisible="preparado == True"/>

                    <button name="action_desbloquear"
                            type="object"
                            string="Desbloquear"
                            invisible="preparado == False"/>

                    <button name="action_finalizar_vuelo"
                            type="object"
                            string="Finalizar Vuelo"
                            invisible="realizado == True"/>
                </header>

                <sheet>

                    <group string="Planificación">
                        <field name="name"
                               readonly="preparado == True"/>
                        <field name="dron_id"
                               readonly="preparado == True"/>
                        <field name="piloto_id"
                               readonly="preparado == True"/>
                        <field name="zona_id"
                                readonly="preparado == True"/>
                    </group>

                    <group string="Estado y Control">
                        <field name="preparado" readonly="1"/>
                        <field name="realizado" readonly="1"/>
                        <field name="peso_total" readonly="1"/>
                        <field name="consumo_estimado" widget="percentage" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Paquetes">
                            <field name="paquetes_ids"
                                   readonly="preparado == True">
                                <list editable="bottom">
                                    <field name="codigo"/>
                                    <field name="name"/>
                                    <field name="peso"/>
                                    <field name="cliente_id"/>
                                </list>
                            </field>

                            <group>
                                <field name="peso_total" readonly="1"/>
                                <field name="consumo_estimado" widget="percentage" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================= -->
    <!-- DRONES -->
    <!-- ========================= -->

    <record id="view_dron_list" model="ir.ui.view">
        <field name="name">dronify.dron.list</field>
        <field name="model">dronify.dron</field>
        <field name="arch" type="xml">
            <list decoration-danger="bateria &lt; 25">
                <field name="name"/>
                <field name="capacidad_max"/>
                <field name="bateria" widget="progressbar"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'disponible'"
                       decoration-warning="estado == 'vuelo'"
                       decoration-danger="estado == 'taller'"/>
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- PAQUETES -->
    <!-- ========================= -->

    <record id="view_paquete_list" model="ir.ui.view">
        <field name="name">dronify.paquete.list</field>
        <field name="model">dronify.paquete</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="name"/>
                <field name="peso"/>
                <field name="cliente_id"/>
                <field name="vuelo_id"/>
                <field name="dron_relacionado"/>
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- ACCIONES -->
    <!-- ========================= -->

    <record id="action_vuelos" model="ir.actions.act_window">
        <field name="name">Vuelos</field>
        <field name="res_model">dronify.vuelo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_drones" model="ir.actions.act_window">
        <field name="name">Drones</field>
        <field name="res_model">dronify.dron</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_paquetes" model="ir.actions.act_window">
        <field name="name">Paquetes</field>
        <field name="res_model">dronify.paquete</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_pilotos" model="ir.actions.act_window">
        <field name="name">Pilotos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_piloto','=',True)]</field>
        <field name="context">{'default_es_piloto': True}</field>
    </record>

    <record id="action_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_cliente','=',True)]</field>
        <field name="context">{'default_es_cliente': True}</field>
    </record>


    <!-- ========================= -->
    <!-- MENÚ -->
    <!-- ========================= -->

    <menuitem id="menu_dronify_root"
              name="Dronify"/>

    <menuitem id="menu_operaciones"
              name="Operaciones"
              parent="menu_dronify_root"/>

    <menuitem id="menu_vuelos"
              name="Vuelos"
              parent="menu_operaciones"
              action="action_vuelos"/>

    <menuitem id="menu_paquetes"
              name="Paquetes"
              parent="menu_operaciones"
              action="action_paquetes"/>

    <menuitem id="menu_flotas"
              name="Flota"
              parent="menu_dronify_root"/>

    <menuitem id="menu_drones"
              name="Drones"
              parent="menu_flotas"
              action="action_drones"/>

    <menuitem id="menu_contactos"
              name="Contactos"
              parent="menu_dronify_root"/>

    <menuitem id="menu_pilotos"
              name="Pilotos"
              parent="menu_contactos"
              action="action_pilotos"/>

    <menuitem id="menu_clientes"
              name="Clientes"
              parent="menu_contactos"
              action="action_clientes"/>

    <!-- ========================= -->
    <!-- EXTENSIÓN CONTACTOS -->
    <!-- ========================= -->

    <record id="view_partner_form_dronify" model="ir.ui.view">
        <field name="name">res.partner.form.dronify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Dronify">
                    <field name="es_cliente"/>
                    <field name="es_vip"
                           invisible="es_cliente == False"/>
                    <field name="es_piloto"/>
                    <field name="licencia"
                           invisible="es_piloto == False"/>
                </group>
            </xpath>


    <!-- Pilotos: solo muestra campos relevantes y oculta pestañas innecesarias -->
    <record id="view_partner_form_piloto" model="ir.ui.view">
        <field name="name">res.partner.form.piloto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Datos de piloto" invisible="not es_piloto">
                    <field name="es_piloto" readonly="1"/>
                    <field name="licencia" required="1"/>
                    <field name="dron_autorizado_ids" widget="many2many_tags"/>
                    <field name="es_cliente"/>
                    <field name="es_vip" invisible="not es_cliente"/>   
                </group>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Algunas versiones de la vista base pueden no contener las pestañas 'contacts',
                 'sales_purchases' o 'internal_notes'. Por compatibilidad, no las ocultamos
                 usando xpath por nombre para evitar errores de carga de la vista. -->
        </field>
    </record>

    <!-- Clientes: solo muestra campos relevantes y oculta pestañas innecesarias -->
    <record id="view_partner_form_cliente" model="ir.ui.view">
        <field name="name">res.partner.form.cliente</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="21"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Datos de cliente" invisible="not es_cliente">
                    <field name="es_cliente" readonly="1"/>
                    <field name="es_vip"/>
                    <field name="es_piloto"/>
                    <field name="licencia" invisible="not es_piloto"/>
                    <field name="dron_autorizado_ids" widget="many2many_tags" invisible="not es_piloto"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Pestañas dependientes de la versión de Odoo; se omiten para evitar ParseError. -->
        </field>
    </record>


</odoo>
